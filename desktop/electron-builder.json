{
  "appId": "local.broadcastcg.studio",
  "productName": "BroadcastCG",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "main.cjs",
    "psd-session.cjs",
    "ae-session.cjs",
    "assets/BroadcastCG-AE-Export.jsx",
    "preload.cjs",
    "window-state.cjs",
    "app/**/*",
    "!app/smoke.cjs",
    "assets/icon.ico",
    "assets/BroadcastCGHost.exe",
    "assets/install-service.ps1",
    "assets/PSD-LICENSES.txt",
    "assets/NETWORK-LICENSES.txt",
    "package.json",
    "assets/Install-ManagedClient.ps1",
    "editor-state.cjs",
    "output-controller.cjs",
    "ndi-controller.cjs",
    "ndi-config.cjs",
    "assets/NDI-NOTICES.txt"
  ],
  "asar": true,
  "extraResources": [
    {
      "from": "assets/BroadcastCGHost.exe",
      "to": "server-tools/BroadcastCGHost.exe"
    },
    {
      "from": "assets/install-service.ps1",
      "to": "server-tools/install-service.ps1"
    },
    {
      "from": "assets/Install-ManagedClient.ps1",
      "to": "server-tools/Install-ManagedClient.ps1"
    },
    {
      "from": "assets/BroadcastCGNdi.exe",
      "to": "output-tools/BroadcastCGNdi.exe"
    }
  ],
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico",
    "artifactName": "BroadcastCG-Setup-x64.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createStartMenuShortcut": true,
    "createDesktopShortcut": false,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false
  },
  "portable": {
    "artifactName": "BroadcastCG-Portable-x64.${ext}"
  },
  "publish": null
}
